<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SubnauticaKnuckles</AssemblyName>
    <RootNamespace>SubnauticaKnuckles</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Subnautica.GameLibs" Version="2.0.0-preview.*" PrivateAssets="all" />
    <PackageReference Include="Subnautica.Nautilus" Version="1.0.0-*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Copy Assets folder next to the DLL when building -->
  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets')" />
  </ItemGroup>
</Project>
